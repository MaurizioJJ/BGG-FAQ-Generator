{
  "manifest_version": 3,
  "name": "BGG FAQ Generator",
  "version": "1.0",
  "description": "Scrape BGG rules forums and generate FAQs using Claude AI",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://boardgamegeek.com/*",
    "https://api.anthropic.com/*"
  ],
  "action": {
    "default_title": "BGG FAQ Generator",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
